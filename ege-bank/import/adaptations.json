{
  "F13F4D": {
    "title": "Диаметр проволоки по длине намотки",
    "sourceDigest": "5bf0089ed5b1a58e39bf659193ac4961ba6d3b1715d685218fe28a9bd8518439",
    "topicSlugs": [
      "measurement"
    ],
    "parts": [
      {
        "type": "element",
        "tag": "p",
        "attrs": {},
        "children": [
          {
            "type": "text",
            "text": "На карандаше плотно, без промежутков, уложены 20 витков медной проволоки. Намотка занимает (15 ± 1) мм вдоль карандаша."
          }
        ]
      },
      {
        "type": "element",
        "tag": "p",
        "attrs": {},
        "children": [
          {
            "type": "text",
            "text": "Определите диаметр проволоки и его погрешность в миллиметрах. Запишите оба числа в порядке «диаметр ± погрешность»."
          }
        ]
      }
    ],
    "key": {
      "rule": "measurement-pair",
      "accepted": [
        "0,75 ± 0,05"
      ]
    },
    "solution": {
      "credit": "Решение INVARIANT",
      "parts": [
        {
          "type": "element",
          "tag": "p",
          "attrs": {},
          "children": [
            {
              "type": "text",
              "text": "Длина намотки равна двадцати диаметрам. Делим измеренную длину и её абсолютную погрешность на 20. Получаем (0,75 ± 0,05) мм."
            }
          ]
        }
      ]
    }
  },
  "1CCC46": {
    "title": "Удлинение пружины по закону Гука",
