          ]
        }
      ]
    }
  },
  "2CB64F": {
    "title": "Ускорение при изменении массы и силы",
    "sourceDigest": "f2b03e8ac5d617e36e4fd0df924c3e9332ee7cf0088d55b61d273125fd3f8f2c",
    "parts": [
      {
        "type": "element",
        "tag": "p",
        "attrs": {},
        "children": [
          {
            "type": "text",
            "text": "В инерциальной системе тело массой m получает ускорение 0,6 м/с² под действием силы F. Каково ускорение тела массой 2m, если приложить к нему силу F/2? Ответ дайте в м/с²."
          }
        ]
      }
    ],
    "key": {
      "rule": "number",
      "accepted": [
        "0,15"
      ]
    },
    "solution": {
      "credit": "Решение INVARIANT",
      "parts": [
        {
          "type": "element",
          "tag": "p",
          "attrs": {},
          "children": [
            {
              "type": "text",
              "text": "По второму закону Ньютона a = F/m. При двукратном уменьшении силы и удвоении массы ускорение составляет четверть исходного."
            }
          ]
        }
      ]
    }
  },
  "B02B49": {
    "title": "Изменение импульса под действием силы",
    "sourceDigest": "4ca9004ccf524f6915e5e9b45a1521157e9fa7382ffa782f5c82248990b33ab4",
    "parts": [
      {
